{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/create/:path*", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/memorial", "destination": "/index.html" },
    { "source": "/memorial/:path*", "destination": "/index.html" },
    { "source": "/gift", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/checkout/:path*", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/index.html" },
    {
      "source": "/((?!api/|functions/|assets/|Auth-Logos/|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
